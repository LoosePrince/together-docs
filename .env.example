# 生产环境必须替换为至少 32 字节的随机值
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
DATABASE_PATH=./data/app.db
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./data/blobs
MAX_UPLOAD_BYTES=52428800
SESSION_DAYS=14
# 逗号分隔，生产环境建议设置为站点实际域名
CORS_ORIGINS=http://localhost:5173
PUBLIC_URL=http://localhost:3000
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=
ONLYOFFICE_INTERNAL_URL=http://host.docker.internal:3000
# S3 可选：STORAGE_DRIVER=s3 时配置
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
